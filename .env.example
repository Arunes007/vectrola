# Vectrola Environment Variables
# Copy this file to .env and fill in your API keys

# YouTube Data API Key (optional, for fetching video IDs)
# Get yours at: https://console.cloud.google.com/apis/credentials
# Create a new API key with YouTube Data API v3 enabled
YOUTUBE_API_KEY=your_youtube_api_key_here

# Genius API Token (optional, for lyrics fetching)
# Get yours at: https://genius.com/api-clients
# Create a new API Client and copy the "Client Access Token"
GENIUS_API_TOKEN=your_genius_token_here
