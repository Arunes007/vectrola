# Vectrola Environment Variables
# Copy this file to .env and fill in your API keys

# YouTube Data API Key (optional, for fetching video IDs)
# Get yours at: https://console.cloud.google.com/apis/credentials
# Create a new API key with YouTube Data API v3 enabled
YOUTUBE_API_KEY=your_youtube_api_key_here

# Genius API Token (optional, for lyrics fetching)
# Get yours at: https://genius.com/api-clients
# Create a new API Client and copy the "Client Access Token"
GENIUS_API_TOKEN=your_genius_token_here

# Google Drive OAuth Credentials (optional - for BYOC users)
# By default, Vectrola uses bundled credentials.
# Power users can provide their own to avoid the "unverified app" warning.
# See docs/gdrive.md for instructions on creating your own credentials.
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_client_secret

# Google Picker (optional - for folder selection UI)
# GOOGLE_PICKER_CLIENT_ID=your_web_app_client_id.apps.googleusercontent.com
# GOOGLE_API_KEY=your_api_key

# =============================================================================
# Multi-Tenant / SaaS Mode (Day 7)
# =============================================================================

# Remote Qdrant (optional - for shared track catalog)
# Deploy Qdrant on Railway, Render, or any cloud provider
# QDRANT_URL=https://your-qdrant.railway.app
# QDRANT_API_KEY=your-api-key

# User identification (optional - auto-generated if not set)
# Useful for multi-device setups or explicit user separation
# VECTROLA_USER_ID=user_abc123

# Multi-tenant mode (enables user-scoped search)
# When true, search results are filtered to only tracks in the user's library
# VECTROLA_MULTI_TENANT=true
